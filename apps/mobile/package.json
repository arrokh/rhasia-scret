{
  "name": "@rhasia-scret/mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.17.0"
  },
  "main": "index.ts",
  "dependencies": {
    "@noble/ciphers": "2.3.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rhasia-scret/client-vault-core": "workspace:*",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-form": "^1.33.2",
    "expo": "~57.0.12",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@react-native/assets-registry": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/js-polyfills": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-preset-expo": "~57.0.6",
    "eslint": "^9.39.1",
    "expo-doctor": "^1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint --config eslint.config.mjs App.tsx app.config.ts index.ts jest.setup.ts src modules/*/index.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --detectOpenHandles",
    "test:full": "pnpm run verify",
    "doctor": "expo-doctor",
    "build:ios-bundle": "expo export --platform ios --output-dir dist/ios",
    "build:android-bundle": "expo export --platform android --output-dir dist/android",
    "build:release-bundles": "pnpm run build:ios-bundle && pnpm run build:android-bundle",
    "build:android-native": "./scripts/build-android-release.sh",
    "test:android-native": "cd android && ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ./gradlew :native-argon2id:connectedDebugAndroidTest",
    "build:ios-simulator": "expo prebuild --clean --no-install --platform ios && cd ios && pod install && xcodebuild -workspace rhasiascret.xcworkspace -scheme rhasiascret -configuration Release -sdk iphonesimulator -derivedDataPath build/derived CODE_SIGNING_ALLOWED=NO build",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run doctor && pnpm run build:release-bundles"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|@noble|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
