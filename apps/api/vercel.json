{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": { "deploymentEnabled": { "main": true, "**": false } },
  "ignoreCommand": "node ../../tools/vercel-ignore.mjs api",
  "installCommand": "pnpm install --filter @rhasia-scret/api... --frozen-lockfile",
  "buildCommand": "DEPLOYMENT_TARGET=vercel VERIFY_DEPLOYMENT_PRODUCTION=1 pnpm run verify:deployment-config && pnpm run build:vercel",
  "rewrites": [{ "source": "/v1/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/vercel.js"
    }
  },
  "crons": [{ "path": "/v1/internal/retention-purge", "schedule": "0 3 * * *" }]
}
