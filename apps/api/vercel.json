{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false,
      "infra/verify/vercel-go-runtime-20261110": true
    }
  },
  "ignoreCommand": "node ../../tools/vercel-ignore.mjs api",
  "installCommand": "pnpm install --filter @rhasia-scret/api... --frozen-lockfile",
  "buildCommand": "DEPLOYMENT_TARGET=vercel pnpm run verify:deployment-config && pnpm run build:vercel",
  "rewrites": [
    { "source": "/v1/health", "destination": "/api/health" },
    { "source": "/v1/time", "destination": "/api/time" },
    { "source": "/v1/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    },
    "api/health.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    },
    "api/time.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    },
    "api/go-runtime-verification.go": {
      "maxDuration": 10
    }
  },
  "crons": [{ "path": "/v1/internal/retention-purge", "schedule": "0 3 * * *" }]
}
