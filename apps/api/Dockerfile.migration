# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /workspace/apps/api
COPY apps/api/go.mod apps/api/go.sum ./
COPY apps/api/cmd/sqitch-migrate ./cmd/sqitch-migrate
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -buildvcs=false -o /out/rhasia-sqitch-migrate ./cmd/sqitch-migrate

FROM sqitch/sqitch:v1.6.1.1@sha256:ccc468702782f376647f7febf06a616ffacf01bd5f066ad589298e387583c60d AS migration
ARG COMMIT_SHA=unknown
LABEL org.opencontainers.image.revision="${COMMIT_SHA}"
WORKDIR /workspace/apps/api
COPY apps/api/sqitch.conf ./sqitch.conf
COPY apps/api/db/sqitch ./db/sqitch
COPY --from=build /out/rhasia-sqitch-migrate /usr/local/bin/rhasia-sqitch-migrate
ENTRYPOINT ["/usr/local/bin/rhasia-sqitch-migrate"]
CMD ["deploy", "--verify"]
