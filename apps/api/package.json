{
  "name": "@rhasia-scret/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "bun run src/bun.ts",
    "dev:bun": "bun run src/bun.ts",
    "dev:node": "tsx src/node.ts",
    "build": "DIRECT_URL=postgresql://127.0.0.1:5432/rhasia_scret_generate pnpm run prisma:generate && pnpm run build:node",
    "build:node": "tsup --config tsup.config.ts",
    "build:vercel": "DIRECT_URL=postgresql://127.0.0.1:5432/rhasia_scret_generate pnpm run prisma:generate && API_BUILD_TARGET=vercel tsup --config tsup.config.ts && tsx scripts/verify-vercel-bundle.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint api src scripts tsup.config.ts",
    "test": "tsx scripts/run-tests.ts",
    "test:unit": "vitest run --exclude=src/tests/integration/**",
    "test:integration": "tsx scripts/run-tests.ts --require-database src/tests/integration",
    "test:integration:container": "tsx scripts/run-postgres-testcontainer.ts --integration",
    "test:container": "tsx scripts/run-postgres-testcontainer.ts --test",
    "test:full": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run build:vercel",
    "test:full:container": "tsx scripts/run-postgres-testcontainer.ts --full",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "tsx scripts/deploy-passwordless-migrations.ts",
    "prisma:preflight-passwordless": "tsx scripts/preflight-passwordless-migration.ts",
    "prisma:seed-passwordless-identities": "tsx scripts/seed-passwordless-identities.ts",
    "verify:passwordless-migration": "tsx scripts/verify-passwordless-migration.ts",
    "verify:database": "tsx scripts/verify-test-database.ts",
    "verify:prisma-connections": "tsx scripts/verify-prisma-connections.ts",
    "verify:deployment-config": "tsx scripts/verify-deployment-config.ts",
    "smoke:deployment": "tsx scripts/smoke-deployment.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@rhasia-scret/api-contract": "workspace:*",
    "@rhasia-scret/client-vault-core": "workspace:*",
    "@simplewebauthn/server": "^14.0.2",
    "dotenv": "^18.0.0",
    "hono": "^4.13.8",
    "jose": "6.2.12",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "eslint": "^10.10.0",
    "prisma": "^7.10.0",
    "testcontainers": "^12.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
