{
  "name": "@rhasia-scret/api-parity",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "go build ./...",
    "typecheck": "pnpm run test:parity:generate && tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "pnpm run test:parity:generate && tsx scripts/run-tests.ts",
    "test:unit": "pnpm run test:parity:generate && vitest run --exclude=src/tests/integration/**",
    "test:integration": "pnpm run test:parity:generate && tsx scripts/run-tests.ts --require-database src/tests/integration",
    "test:runtime-parity": "tsx scripts/runtime-parity.ts",
    "test:runtime-parity:container": "tsx scripts/run-postgres-testcontainer.ts --runtime-parity",
    "test:integration:container": "tsx scripts/run-postgres-testcontainer.ts --integration",
    "test:container": "tsx scripts/run-postgres-testcontainer.ts --test",
    "test:full": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "test:full:container": "tsx scripts/run-postgres-testcontainer.ts --full",
    "test:parity:generate": "DIRECT_URL=postgresql://127.0.0.1:5432/rhasia_scret_generate prisma generate",
    "test:parity:validate": "DIRECT_URL=postgresql://127.0.0.1:5432/rhasia_scret_generate prisma validate",
    "verify:deployment-config": "go run ./cmd/api verify-config",
    "smoke:deployment": "tsx scripts/smoke-deployment.ts"
  },
  "devDependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@rhasia-scret/api-contract": "workspace:*",
    "@rhasia-scret/client-vault-core": "workspace:*",
    "@simplewebauthn/server": "^14.1.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "hono": "4.13.17",
    "jose": "6.2.17",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.1.0",
    "zod": "^4.6.7"
  }
}
