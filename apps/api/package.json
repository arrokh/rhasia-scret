{
  "name": "@rhasia-scret/api-test-tools",
  "version": "0.4.2",
  "description": "Node-based test, development, and deployment-check tooling for the Go API; not a production runtime.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "lint": "eslint scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration:container": "tsx scripts/run-postgres-testcontainer.ts --integration",
    "test:container": "tsx scripts/run-postgres-testcontainer.ts --test",
    "test:full": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "test:full:container": "tsx scripts/run-postgres-testcontainer.ts --full",
    "verify:deployment-config": "go run ./cmd/api verify-config",
    "smoke:deployment": "tsx scripts/smoke-deployment.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "testcontainers": "^12.2.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.1.1"
  }
}
