{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhasia-scret-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "WEB_ORIGIN": "https://rhasia-scret.nooroctavian.id",
    "NODE_ENV": "production",
    "AUTH_BACKEND": "passwordless",
    "AUTH_APP_ORIGIN": "https://rhasia-scret.nooroctavian.id",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
}
