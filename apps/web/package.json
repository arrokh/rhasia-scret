{
  "name": "@rhasia-scret/web",
  "version": "0.3.3",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "tsx scripts/remove-client-source-maps.ts && pnpm run verify:build-output",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration --project contract",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:architecture": "dependency-cruiser --config .dependency-cruiser.cjs src",
    "test:full": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:architecture && pnpm run build && pnpm run performance:bundles:verify && BROWSER_TEST_REUSE_BUILD=1 BROWSER_TEST_SEQUENTIAL=\"${BROWSER_TEST_SEQUENTIAL:-1}\" pnpm run test:browser",
    "test:browser": "tsx scripts/run-browser-gate.ts",
    "test:browser:smoke": "tsx scripts/run-browser-suite.ts smoke",
    "test:browser:e2e": "tsx scripts/run-browser-suite.ts e2e",
    "test:browser:pwa": "playwright test --config playwright.pwa.config.ts --max-failures=1",
    "clean:next-dev": "tsx scripts/clear-next-dev-cache.ts",
    "performance": "playwright test --config playwright.performance.config.ts",
    "performance:bundles": "tsx scripts/report-route-bundles.ts --build-dir .next --output ../../test-results/performance/route-bundles.json --enforce",
    "performance:bundles:verify": "tsx scripts/report-route-bundles.ts --build-dir .next --output test-results/performance/route-bundles.json --enforce",
    "verify:deployment-config": "tsx scripts/verify-deployment-config.ts",
    "verify:build-output": "tsx scripts/verify-build-output.ts",
    "verify:dependency-licenses": "tsx scripts/verify-dependency-licenses.ts"
  },
  "dependencies": {
    "@rhasia-scret/api-contract": "workspace:*",
    "@rhasia-scret/client-vault-core": "workspace:*",
    "@scure/bip39": "2.4.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.106.1",
    "@zxing/browser": "0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "hash-wasm": "4.12.0",
    "jose": "6.2.15",
    "jsqr": "1.4.0",
    "lucide-react": "^1.69.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "posthog-js": "^1.447.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "31.0.0",
    "playwright": "^1.65.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  }
}
