{
  "name": "@rhasia-scret/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "postbuild": "tsx scripts/remove-client-source-maps.ts && pnpm run verify:build-output",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration --project contract",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:architecture": "dependency-cruiser --config .dependency-cruiser.cjs src",
    "test:full": "pnpm run prisma:validate && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:architecture && pnpm run build && pnpm run performance:bundles:verify && BROWSER_TEST_REUSE_BUILD=1 pnpm run test:browser",
    "test:browser": "tsx scripts/run-browser-gate.ts",
    "test:browser:smoke": "tsx scripts/run-browser-suite.ts smoke",
    "test:browser:e2e": "tsx scripts/run-browser-suite.ts e2e",
    "test:browser:pwa": "playwright test --config playwright.pwa.config.ts --max-failures=1",
    "test:browser:oidc": "E2E_AUTH_BACKEND=oidc playwright test --config playwright.e2e.config.ts",
    "clean:next-dev": "tsx scripts/clear-next-dev-cache.ts",
    "performance": "playwright test --config playwright.performance.config.ts",
    "performance:bundles": "tsx scripts/report-route-bundles.ts --build-dir .next --output ../../test-results/performance/route-bundles.json --enforce",
    "performance:bundles:verify": "tsx scripts/report-route-bundles.ts --build-dir .next --output test-results/performance/route-bundles.json --enforce",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:backfill-external-identities": "tsx scripts/backfill-external-identities.ts",
    "verify:database": "tsx scripts/verify-test-database.ts",
    "verify:prisma-connections": "tsx scripts/verify-prisma-connections.ts",
    "verify:deployment-config": "tsx scripts/verify-deployment-config.ts",
    "verify:supabase-auth": "tsx scripts/verify-supabase-auth.ts",
    "verify:build-output": "tsx scripts/verify-build-output.ts",
    "verify:dependency-licenses": "tsx scripts/verify-dependency-licenses.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@rhasia-scret/client-vault-core": "workspace:*",
    "@scure/bip39": "2.2.0",
    "@simplewebauthn/server": "^13.3.2",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@zxing/browser": "0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "hash-wasm": "4.12.0",
    "jose": "6.1.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.26.0",
    "next": "^16.3.4",
    "next-intl": "^4.13.4",
    "openid-client": "6.8.4",
    "pg": "^8.22.0",
    "posthog-js": "^1.418.10",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.7.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "dependency-cruiser": "^17.3.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
