# Authentication deployment mode: none, supabase, or oidc (defaults to supabase).
AUTH_BACKEND=supabase

# Supabase server adapter
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional browser analytics. Set each provider's values together, or leave them empty.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Native verified-link signing identities (server association documents)
MOBILE_APPLE_TEAM_ID=
MOBILE_ANDROID_CERT_SHA256=

# OIDC server adapter (required only when AUTH_BACKEND=oidc).
OIDC_ISSUER=https://issuer.example.test
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://example.test/auth/oidc/callback
OIDC_AUDIENCE=
OIDC_SESSION_SECRET=
# Comma-separated verified emails admitted by the OIDC deployment policy.
AUTH_ADMITTED_EMAILS=

# Runtime PostgreSQL connection. Never commit a real credential.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shared_totp_vault?schema=public
# Direct PostgreSQL connection for Prisma CLI migrations; required by Prisma config.
# Production providers should supply a separate direct endpoint from DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/shared_totp_vault?schema=public

# WebAuthn Passkey-Assisted Recovery for local development.
# Production requires the deployed hostname and exact HTTPS origin.
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000

# Vercel Cron authenticates the bounded retention purge endpoint with this value.
# Example only; generate a unique value of at least 32 random characters for each environment.
# Never expose it to browser code or commit a real secret.
CRON_SECRET=replace-with-a-random-secret-at-least-32-characters
