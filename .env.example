# Root environment contract
# =========================
# Copy this file to .env at the repository root. All local and deployment
# environment values belong here; do not create apps/web/.env or
# apps/mobile/.env.local. Keep public client values separate from server-only
# credentials, and never commit a real secret.

# ---------------------------------------------------------------------------
# API persistence tooling (Bun runtime, Prisma CLI, scripts, and tests)
# ---------------------------------------------------------------------------
# DATABASE_URL is the pooled Bun-runtime endpoint. DIRECT_URL is the direct
# migration/admin endpoint; production deployments must use separate endpoints.
# The Cloudflare Worker uses its Hyperdrive binding instead. Web and native
# clients never receive either value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shared_totp_vault?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/shared_totp_vault?schema=public

# ---------------------------------------------------------------------------
# Hosted web service: presentation, SSR gateway, and browser proxy
# ---------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8787
# Generate a unique value of at least 32 random characters.
API_PROXY_SECRET=replace-with-a-random-proxy-secret-at-least-32-characters

# Hosted API service: self-managed passwordless authentication (server-only)
# ---------------------------------------------------------------------------
# Passwordless is the default. Use AUTH_BACKEND=none only for an intentional
# local-only browser deployment, or AUTH_BACKEND=oidc for the optional OIDC adapter.
AUTH_BACKEND=passwordless
AUTH_APP_ORIGIN=http://localhost:3000
# Set true only when a trusted reverse proxy strips and rewrites forwarded headers.
AUTH_TRUST_PROXY_HEADERS=false
# Optional development-only custom native callback; omit to use /auth/mobile.
AUTH_MOBILE_REDIRECT_URL=
# Generate two different random values with at least 32 characters.
AUTH_MAGIC_LINK_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-characters
AUTH_MAGIC_LINK_TTL_SECONDS=900
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Cloudflare Turnstile: use this always-pass testing pair for local development.
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/.
# Replace both values with the production site key/secret before deployment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Hosted API service: HTTP email provider delivery (server-only)
# Required when AUTH_BACKEND=passwordless. Replace the example endpoint and
# token with a reachable HTTPS mail gateway; this example host is not a local
# mail server. The API POST payload is { from, to, subject, text, html } and
# uses EMAIL_PROVIDER_TOKEN as a Bearer token. Keep these values out of Web
# and native client environments.
EMAIL_PROVIDER_URL=https://email-provider.example.test/send
EMAIL_PROVIDER_TOKEN=
AUTH_EMAIL_FROM=no-reply@example.test
AUTH_EMAIL_FROM_NAME=rhasia-scret

# Hosted web service: optional provider-neutral OIDC adapter (server-only)
OIDC_ISSUER=https://issuer.example.test
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://example.test/auth/oidc/callback
OIDC_AUDIENCE=
OIDC_SESSION_SECRET=
# Comma-separated verified emails admitted by the OIDC deployment policy.
AUTH_ADMITTED_EMAILS=

# Hosted web service: WebAuthn recovery and verified native-link association
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000
MOBILE_APPLE_TEAM_ID=
MOBILE_ANDROID_CERT_SHA256=

# Public web analytics and API retention scheduler
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
# Generate a unique value of at least 32 random characters.
CRON_SECRET=replace-with-a-random-secret-at-least-32-characters

# ---------------------------------------------------------------------------
# Native mobile build: public values only (Expo embeds these in the client)
# ---------------------------------------------------------------------------
# These values are read from this root file by apps/mobile/app.config.ts.
# Never put SMTP, auth, OIDC, database, cron, Vault, OTP, or private-key
# material in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_WEB_ORIGIN=https://app.example.com
EXPO_PUBLIC_AUTH_REDIRECT_URL=https://app.example.com/auth/mobile
# Release-validation builds only; omit or set 0 for the product app.
EXPO_PUBLIC_NATIVE_CRYPTO_VALIDATION=0

# ---------------------------------------------------------------------------
# Docker Compose: database bootstrap and published web port
# ---------------------------------------------------------------------------
# Compose passes the hosted-web values above into the web container and builds
# DATABASE_URL/DIRECT_URL from these database bootstrap values for containers.
POSTGRES_DB=shared_totp_vault
POSTGRES_USER=rhasia
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
# Host-only development port used by `pnpm dev:db`; production Compose does not publish PostgreSQL.
POSTGRES_HOST_PORT=55432
APP_PORT=3000
# Required by docker-compose.yml; use the current short Git SHA.
COMMIT_SHA=replace-with-current-short-git-sha

# ---------------------------------------------------------------------------
# Intentional local/test overrides (optional; keep out of production secrets)
# ---------------------------------------------------------------------------
# Browser gate and performance variables are normally supplied by their
# scripts/CI and are documented in docs/browser-test-runtime.md.
