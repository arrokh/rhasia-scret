{
  "name": "rhasia-scret",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "pnpm run dev:local",
    "dev:api": "pnpm --dir apps/api run dev:bun",
    "dev:web": "pnpm --dir apps/web run dev",
    "dev:local": "node tools/run-local-dev.mjs",
    "dev:db": "sh -c 'export COMPOSE_PROJECT_NAME=rhasia-scret-dev COMMIT_SHA=\"$(git rev-parse --short HEAD)\"; docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db'",
    "dev:db:migrate": "node tools/confirm-database-operation.mjs 'the development database migration' && sh -c 'export COMPOSE_PROJECT_NAME=rhasia-scret-dev COMMIT_SHA=\"$(git rev-parse --short HEAD)\"; docker compose -f docker-compose.yml -f docker-compose.dev.yml run --build --rm migrate'",
    "prod:db:migrate": "test -f .env.prod || { printf '%s\\n' 'Missing .env.prod; refusing to run the production migration.' >&2; exit 1; }; node tools/confirm-database-operation.mjs 'the production database migration' && docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod-migration.yml run --build --rm --no-deps migrate",
    "dev:db:down": "node tools/confirm-database-operation.mjs 'stop the development Compose stack' && COMPOSE_PROJECT_NAME=rhasia-scret-dev COMMIT_SHA=\"$(git rev-parse --short HEAD)\" docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "build": "pnpm --filter @rhasia-scret/api build && pnpm --filter @rhasia-scret/web build",
    "start": "pnpm --filter @rhasia-scret/web start",
    "format": "prettier --write --ignore-unknown . && pnpm run format:prisma",
    "format:check": "prettier --check --ignore-unknown . && pnpm run format:prisma:check",
    "format:prisma": "node tools/format-prisma.mjs",
    "format:prisma:check": "node tools/verify-prisma-format.mjs",
    "lint": "pnpm --filter @rhasia-scret/api lint && pnpm --filter @rhasia-scret/api-contract lint && pnpm --filter @rhasia-scret/api-client lint && pnpm --filter @rhasia-scret/web lint && pnpm --dir apps/mobile run lint",
    "typecheck:web": "pnpm --filter @rhasia-scret/web typecheck",
    "typecheck:mobile": "pnpm --dir apps/mobile run typecheck",
    "typecheck:core": "pnpm --filter @rhasia-scret/client-vault-core typecheck",
    "typecheck": "pnpm run typecheck:core && pnpm --filter @rhasia-scret/api typecheck && pnpm --filter @rhasia-scret/api-contract typecheck && pnpm --filter @rhasia-scret/api-client typecheck && pnpm run typecheck:web && pnpm run typecheck:mobile",
    "test:web": "pnpm --filter @rhasia-scret/web test",
    "test:mobile": "pnpm --dir apps/mobile run test",
    "test:core": "pnpm --filter @rhasia-scret/client-vault-core test",
    "test:hosted": "pnpm run test:release-evidence && pnpm run test:core && pnpm --filter @rhasia-scret/api test && pnpm --filter @rhasia-scret/api-contract test && pnpm --filter @rhasia-scret/api-client test && pnpm run test:web && pnpm run test:mobile",
    "test": "node tools/run-test.mjs",
    "test:parallel": "pnpm --parallel --stream --filter @rhasia-scret/client-vault-core --filter @rhasia-scret/api --filter @rhasia-scret/api-contract --filter @rhasia-scret/api-client --filter @rhasia-scret/web --filter @rhasia-scret/mobile run test",
    "test:unit": "pnpm --filter @rhasia-scret/web test:unit",
    "test:unit:api": "pnpm --filter @rhasia-scret/api test:unit",
    "test:integration": "pnpm --filter @rhasia-scret/web test:integration",
    "test:contract": "pnpm --filter @rhasia-scret/web test:contract",
    "test:browser": "pnpm --filter @rhasia-scret/web test:browser",
    "test:browser:smoke": "pnpm --filter @rhasia-scret/web test:browser:smoke",
    "test:browser:e2e": "pnpm --filter @rhasia-scret/web test:browser:e2e",
    "test:browser:pwa": "pnpm --filter @rhasia-scret/web test:browser:pwa",
    "test:browser:oidc": "pnpm --filter @rhasia-scret/web test:browser:oidc",
    "clean:next-dev": "pnpm --filter @rhasia-scret/web clean:next-dev",
    "mobile:verify": "pnpm --dir apps/mobile run verify",
    "test:architecture": "pnpm --filter @rhasia-scret/web test:architecture",
    "test:full:core": "pnpm --filter @rhasia-scret/client-vault-core test:full",
    "test:full:web": "pnpm --filter @rhasia-scret/web test:full",
    "test:integration:container": "pnpm --filter @rhasia-scret/api test:integration:container",
    "test:container": "pnpm --filter @rhasia-scret/api test:container",
    "test:full:container": "pnpm --filter @rhasia-scret/api test:full:container",
    "test:full:mobile": "pnpm --dir apps/mobile run test:full",
    "test:full:direct": "pnpm --parallel --stream --filter @rhasia-scret/client-vault-core --filter @rhasia-scret/api --filter @rhasia-scret/api-contract --filter @rhasia-scret/api-client --filter @rhasia-scret/web --filter @rhasia-scret/mobile run test:full",
    "test:ci-changes": "node --test tools/detect-ci-changes.test.mjs",
    "test:full:hosted": "pnpm run test:ci-changes && pnpm run format:check && pnpm run verify:version-alignment && pnpm run verify:ci-policy && pnpm run verify:release-evidence && pnpm run test:full:direct",
    "test:full": "node tools/run-test-full.mjs",
    "ci:local": "pnpm run test:full",
    "test:performance": "pnpm --filter @rhasia-scret/web performance",
    "prisma:generate": "pnpm --filter @rhasia-scret/api prisma:generate",
    "prisma:validate": "pnpm --filter @rhasia-scret/api prisma:validate",
    "prisma:migrate:dev": "pnpm --filter @rhasia-scret/api prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @rhasia-scret/api prisma:migrate:deploy",
    "prisma:preflight-passwordless": "pnpm --filter @rhasia-scret/api prisma:preflight-passwordless",
    "prisma:seed-passwordless-identities": "pnpm --filter @rhasia-scret/api prisma:seed-passwordless-identities",
    "verify:passwordless-migration": "pnpm --filter @rhasia-scret/api verify:passwordless-migration",
    "verify:database": "pnpm --filter @rhasia-scret/api verify:database",
    "verify:prisma-connections": "pnpm --filter @rhasia-scret/api verify:prisma-connections",
    "verify:deployment-config": "pnpm --filter @rhasia-scret/api verify:deployment-config && pnpm --filter @rhasia-scret/web verify:deployment-config",
    "verify:build-output": "pnpm --filter @rhasia-scret/web verify:build-output",
    "verify:dependency-licenses": "pnpm --filter @rhasia-scret/web verify:dependency-licenses",
    "verify:ci-policy": "node tools/verify-ci-policy.mjs",
    "verify:version-alignment": "node tools/verify-version-alignment.mjs",
    "verify:release-evidence": "node tools/verify-release-evidence.mjs",
    "test:release-evidence": "node --test tools/verify-release-evidence.test.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.2.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6"
  },
  "lint-staged": {
    "*.{cjs,css,js,json,md,mjs,ts,tsx,yaml,yml}": "prettier --write --ignore-unknown",
    "*.prisma": "pnpm run format:prisma"
  }
}
